{
	"name": "dwasm/nextcloud",
	"description": "Doom (Dwasm) — play the Dwasm WebAssembly engine inside Nextcloud",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"psr-4": {
			"OCA\\Dwasm\\": "lib/"
		}
	},
	"scripts": {
		"lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
		"test:unit": "vendor/bin/phpunit -c tests/php/phpunit.xml --no-coverage --colors=always"
	},
	"require": {
		"php": "^8.1"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-stable30",
		"phpunit/phpunit": "^10.5"
	},
	"autoload-dev": {
		"psr-4": {
			"OCP\\": "vendor/nextcloud/ocp/OCP/"
		}
	}
}
